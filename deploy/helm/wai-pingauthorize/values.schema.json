{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["namespace", "images", "decisionIngressNamespaces", "storage", "vault", "resources"],
  "properties": {
    "namespace": {"const": "wai-pingauthorize"},
    "images": {
      "type": "object", "additionalProperties": false, "required": ["runtime"],
      "properties": {
        "runtime": {"type": "string", "pattern": "^docker.io/pingidentity/pingauthorize@sha256:[a-f0-9]{64}$"}
      }
    },
    "decisionIngressNamespaces": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["wai-strict"]}
    },
    "storage": {
      "type": "object", "additionalProperties": false, "required": ["size", "storageClassName"],
      "properties": {"size": {"type": "string", "minLength": 2}, "storageClassName": {"type": "string", "minLength": 1}}
    },
    "vault": {
      "type": "object", "additionalProperties": false,
      "required": ["address", "connectionName", "caCertSecretRef", "authName", "authServiceAccount", "role", "audience", "kubernetesMount", "kvMount", "refreshAfter"],
      "properties": {
        "address": {"type": "string", "pattern": "^https://"},
        "connectionName": {"const": "wai-pingauthorize-vault"},
        "caCertSecretRef": {"const": "wai-vault-server-ca"},
        "authName": {"const": "wai-pingauthorize-vault-auth"},
        "authServiceAccount": {"const": "wai-pingauthorize-vault-auth"},
        "role": {"const": "wai-pingauthorize-11-1"},
        "audience": {"const": "vault"},
        "kubernetesMount": {"type": "string", "minLength": 1},
        "kvMount": {"type": "string", "minLength": 1},
        "refreshAfter": {"type": "string", "minLength": 2}
      }
    },
    "resources": {"type": "object", "required": ["requests", "limits"]}
  }
}
