# Copy to .env.local and populate from your Ping Identity DevOps account.
# Never commit .env.local.
PING_IDENTITY_DEVOPS_USER=
PING_IDENTITY_DEVOPS_KEY=

# PingFederate Admin API credentials for the local development profile.
PF_ADMIN_URL=https://localhost:9999/pf-admin-api/v1
PF_ADMIN_USERNAME=
PF_ADMIN_PASSWORD=
PF_ADMIN_INSECURE=true

# Secret for the Terraform-managed RFC 8693 client.
TF_VAR_token_exchange_client_secret=

# Development-only authenticated subject-token flow. Use unique random values.
TF_VAR_lab_user_password=
TF_VAR_lab_user_client_secret=
TF_VAR_mcp_gateway_client_secret=

# Existing non-secret PingFederate configuration references used by discovery generation.
PF_TRANSACTION_ISSUER=https://localhost:9031
